Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Some hosts (CGI/FastCGI) drop the Authorization header before PHP sees it.
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule ^feed\.xml$ feed.php [L,QSA]
</IfModule>

# Never serve secrets, helpers or the schema over HTTP.
<FilesMatch "^(config(\.example)?\.php|lib\.php|schema\.sql|\.user\.ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
